#!/usr/bin/env zsh
#
# Read what focus-watch logged: which application took focus while you were
# not touching the machine.
#
#   focus-report                 # thefts in the last 24h, worst offender first
#   focus-report --since 2h      # 30m, 2h, 7d — default 24h, "all" for everything
#   focus-report --all           # count the switches you made as well
#   focus-report --follow        # watch it happen live
#   focus-report --log PATH      # default ~/Library/Logs/davconf/focus.tsv
#
# awk rather than Python, deliberately. macOS has no python3 of its own — it
# comes with the Command Line Tools — and the machine this exists for is the
# managed work Mac, where that is not a given. awk is in /usr/bin on every Mac
# there has ever been.

emulate -L zsh
zmodload zsh/datetime

log=$HOME/Library/Logs/davconf/focus.tsv
since=24h
show_all=no
follow=no

while (( $# )); do
  case $1 in
    --since)   since=$2; shift 2 ;;
    --all)     show_all=yes; shift ;;
    --follow)  follow=yes; shift ;;
    --log)     log=$2; shift 2 ;;
    -h|--help) sed -n '2,/^$/p' ${(%):-%x} | sed 's/^# \{0,1\}//'; return 0 ;;
    *)         print -u2 -- "unknown option: $1"; return 2 ;;
  esac
done

info() { print -r -- $'\e[1;34m==>\e[0m '"$1" }
warn() { print -r -- $'\e[1;33m==>\e[0m '"$1" }

if [[ ! -r $log ]]; then
  warn "No log at $log."
  warn "Is the watcher running?  launchctl print gui/$UID/dev.uebelacker.davconf.focus"
  return 1
fi

# --- --follow ---------------------------------------------------------------
# Not a second implementation of the formatting: the same awk program, fed by
# tail -f instead of the file, with the summary suppressed.
if [[ $follow == yes ]]; then
  info "Watching $log — ctrl-c to stop"
  tail -f -n 0 $log | awk -F'\t' -v showall="$show_all" '
    /^#/ { next }
    {
      verdict = $3
      if (verdict == "user" && showall != "yes") next
      colour = (verdict == "theft") ? "\033[1;31m" : (verdict == "gap") ? "\033[1;33m" : "\033[0;36m"
      idle = ($4 >= 0) ? sprintf("idle %ds", $4 / 1000) : ""
      if (verdict == "gap") idle = sprintf("asleep %ds", $4)
      printf "%s%-5s\033[0m %s  %-28s %s\n", colour, verdict, substr($1, 12, 8), $5, idle
      fflush()
    }'
  return 0
fi

# --- cutoff -----------------------------------------------------------------
cutoff=0
if [[ $since != all ]]; then
  if [[ $since =~ '^([0-9]+)([mhd])$' ]]; then
    local n=$match[1] unit=$match[2]
    case $unit in
      m) cutoff=$(( EPOCHSECONDS - n * 60 )) ;;
      h) cutoff=$(( EPOCHSECONDS - n * 3600 )) ;;
      d) cutoff=$(( EPOCHSECONDS - n * 86400 )) ;;
    esac
  else
    print -u2 -- "--since takes 30m, 2h, 7d or 'all' (got: $since)"
    return 2
  fi
fi

info "Focus log: $log"
[[ $since == all ]] && info "Everything on record" || info "Last $since"
print

# One pass, grouping as it goes. $2 is the epoch, so the cutoff is a numeric
# compare and no date parsing is needed anywhere.
awk -F'\t' -v cutoff="$cutoff" -v showall="$show_all" '
  /^#/ { next }
  $2 < cutoff { next }

  {
    verdict = $3
    seen[verdict]++
    if (verdict == "theft") {
      key = $5 "\t" $6
      n[key]++
      if (!(key in first)) first[key] = $1
      last[key] = $1
      idle[key] += int($4 / 1000)
      # Who it was taken *from* is the other half of the complaint: focus
      # leaving the editor mid-sentence is the thing you noticed.
      victim[key "\t" $8]++
    }
    if (verdict == "gap") gaps = gaps sprintf("    %s  after %ds asleep, front app was %s\n", substr($1,1,19), $4, $5)
  }

  END {
    if (seen["theft"] == 0) {
      printf "    No focus theft recorded"
      if (seen["user"] > 0) printf " — %d switches, all of them yours", seen["user"]
      printf ".\n"
    } else {
      printf "    \033[1m%d focus thefts\033[0m, by %s:\n\n", seen["theft"], (length(n) == 1 ? "one app" : length(n) " apps")
      # Sort by count, descending — insertion sort over a handful of keys.
      m = 0
      for (k in n) { keys[++m] = k }
      for (i = 2; i <= m; i++) {
        hold = keys[i]
        for (j = i - 1; j >= 1 && n[keys[j]] < n[hold]; j--) keys[j+1] = keys[j]
        keys[j+1] = hold
      }
      for (i = 1; i <= m; i++) {
        split(keys[i], f, "\t")
        printf "    %4d  \033[1;31m%-26s\033[0m %-32s\n", n[keys[i]], f[1], f[2]
        printf "          first %s   last %s   avg idle %ds\n\n",
               substr(first[keys[i]], 1, 19), substr(last[keys[i]], 1, 19),
               idle[keys[i]] / n[keys[i]]
      }
      printf "    Taken from:\n"
      for (v in victim) { split(v, f, "\t"); printf "    %4d  %s -> %s\n", victim[v], f[3], f[1] }
      printf "\n"
      if (seen["user"] > 0) printf "    (%d other switches were yours — you had just used the keyboard or mouse.)\n", seen["user"]
    }
    if (gaps != "") printf "\n    Sleep/wake in this window — theft often clusters here:\n%s", gaps
  }' $log
