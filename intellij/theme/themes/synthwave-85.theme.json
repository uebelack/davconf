{
  "name": "Synthwave '85",
  "dark": true,
  "author": "davconf",
  "editorScheme": "/themes/synthwave-85.xml",
  "colors": {
    "accentColor": "#f92aad",
    "secondaryAccent": "#00f0ff",
    "primaryBackground": "#241b3a",
    "secondaryBackground": "#150d2b",
    "editorBackground": "#1a1033",
    "chromeBackground": "#120a25",
    "hoverBackground": "#2f2350",
    "selectionBackground": "#48285c",
    "selectionInactive": "#2f2350",
    "primaryForeground": "#d4c8ff",
    "brightForeground": "#ffffff",
    "dimForeground": "#6e5c96",
    "borderColor": "#120a25",
    "separatorColor": "#3b3163",
    "coral": "#fe4450",
    "gold": "#fede5d",
    "lime": "#72f1b8",
    "magenta": "#ff7edb"
  },
  "ui": {
    "*": {
      "background": "primaryBackground",
      "foreground": "primaryForeground",
      "infoForeground": "dimForeground",
      "selectionBackground": "selectionBackground",
      "selectionForeground": "brightForeground",
      "selectionInactiveBackground": "selectionInactive",
      "selectionBackgroundInactive": "selectionInactive",
      "selectionInactiveForeground": "primaryForeground",
      "inactiveBackground": "primaryBackground",
      "disabledBackground": "primaryBackground",
      "disabledForeground": "dimForeground",
