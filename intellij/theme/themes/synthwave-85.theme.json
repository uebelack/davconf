      "borderColor": "borderColor",
      "disabledBorderColor": "borderColor",
      "focusedBorderColor": "accentColor",
      "focusColor": "accentColor",
      "separatorColor": "separatorColor",
      "arc": "6"
    },
    "Editor": {
      "background": "editorBackground",
      "shortcutForeground": "accentColor"
    },
    "EditorTabs": {
      "background": "secondaryBackground",
      "underlinedTabBackground": "editorBackground",
      "underlinedTabForeground": "accentColor",
      "underlineColor": "accentColor",
      "inactiveUnderlineColor": "secondaryAccent",
      "hoverBackground": "hoverBackground",
      "underlineHeight": 2,
      "borderColor": "borderColor"
    },
    "DefaultTabs": {
      "background": "secondaryBackground",
      "underlinedTabBackground": "editorBackground",
      "underlineColor": "accentColor",
      "hoverBackground": "hoverBackground"
    },
    "ToolWindow": {
      "background": "secondaryBackground",
      "Button": {
        "hoverBackground": "hoverBackground",
        "selectedBackground": "selectionBackground",
        "selectedForeground": "accentColor"
