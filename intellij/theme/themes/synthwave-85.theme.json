      "endBackground": "#2f2350",
      "startBorderColor": "separatorColor",
      "endBorderColor": "separatorColor",
      "focusedBorderColor": "accentColor",
      "default": {
        "startBackground": "magenta",
        "endBackground": "accentColor",
        "foreground": "#1a1033",
        "startBorderColor": "accentColor",
        "endBorderColor": "accentColor",
        "focusColor": "secondaryAccent",
        "focusedBorderColor": "secondaryAccent"
      }
    },
    "ActionButton": {
      "hoverBackground": "hoverBackground",
      "hoverBorderColor": "separatorColor",
      "pressedBackground": "selectionBackground",
      "pressedBorderColor": "accentColor"
    },
    "ComboBox": {
      "background": "secondaryBackground",
      "nonEditableBackground": "secondaryBackground",
      "ArrowButton": {
        "background": "secondaryBackground",
        "iconColor": "accentColor",
        "nonEditableBackground": "secondaryBackground"
      }
    },
    "TextField": {
      "background": "secondaryBackground",
      "caretForeground": "secondaryAccent"
    },
    "TextArea": {
      "background": "secondaryBackground",
      "caretForeground": "secondaryAccent"
    },
    "PasswordField": {
      "background": "secondaryBackground",
      "caretForeground": "secondaryAccent"
    },
    "SearchField": {
      "background": "secondaryBackground"
    },
    "List": {
      "background": "primaryBackground",
      "hoverBackground": "hoverBackground"
    },
    "Tree": {
      "background": "secondaryBackground",
      "hoverBackground": "hoverBackground",
      "modifiedItemForeground": "gold"
    },
    "Table": {
      "background": "primaryBackground",
      "stripeColor": "secondaryBackground",
      "gridColor": "separatorColor",
      "hoverBackground": "hoverBackground"
    },
    "TableHeader": {
      "background": "secondaryBackground",
      "bottomSeparatorColor": "separatorColor"
    },
    "TabbedPane": {
      "underlineColor": "accentColor",
      "hoverColor": "hoverBackground",
      "focusColor": "hoverBackground",
      "contentAreaColor": "separatorColor"
