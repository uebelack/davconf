    "Link": {
      "activeForeground": "secondaryAccent",
      "hoverForeground": "#8bfff5",
      "pressedForeground": "accentColor",
      "visitedForeground": "#fb66c4",
      "secondaryForeground": "dimForeground"
    },
    "ProgressBar": {
      "progressColor": "accentColor",
      "indeterminateStartColor": "magenta",
      "indeterminateEndColor": "secondaryAccent",
      "trackColor": "separatorColor",
      "failedColor": "coral",
      "failedEndColor": "coral",
      "passedColor": "lime",
      "passedEndColor": "lime"
    },
    "ScrollBar": {
      "thumbColor": "#49549566",
      "hoverThumbColor": "#f92aad66",
      "trackColor": "#00000000",
      "Mac": {
        "thumbColor": "#49549566",
        "hoverThumbColor": "#f92aad66",
        "Transparent": {
          "thumbColor": "#49549544",
          "hoverThumbColor": "#f92aad66"
        }
      }
    },
    "Separator": {
      "separatorColor": "separatorColor"
    },
    "Notification": {
      "background": "primaryBackground",
      "borderColor": "separatorColor",
      "errorBackground": "#3a0f1e",
      "errorBorderColor": "coral",
      "errorForeground": "#ffd7d7",
      "MoreButton": {
        "background": "secondaryBackground",
        "innerBorderColor": "separatorColor"
      },
      "ToolWindow": {
        "informativeBackground": "primaryBackground",
        "informativeBorderColor": "secondaryAccent",
        "warningBackground": "#3a2f12",
        "warningBorderColor": "gold",
        "errorBackground": "#3a0f1e",
        "errorBorderColor": "coral"
      }
    },
    "ValidationTooltip": {
      "errorBackground": "#3a0f1e",
      "errorBorderColor": "coral",
      "warningBackground": "#3a2f12",
      "warningBorderColor": "gold"
    },
    "FileColor": {
      "Blue": "#1d2a4a",
      "Green": "#1c3230",
      "Orange": "#3a2418",
      "Rose": "#3a1b30",
      "Violet": "#2a1c45",
      "Yellow": "#3a3418"
    },
    "VersionControl": {
      "FileHistory": {
        "Commit": {
          "selectedBranchBackground": "selectionInactive"
        }
      },
      "Log": {
        "Commit": {
          "currentBranchBackground": "selectionInactive",
          "unmatchedForeground": "dimForeground"
        }
      },
      "RefLabel": {
        "foreground": "primaryForeground"
      }
    },
    "Debugger": {
      "Variables": {
        "changedValueForeground": "gold",
        "collectingDataForeground": "dimForeground",
        "errorMessageForeground": "coral",
        "evaluatingExpressionForeground": "dimForeground",
        "modifyingValueForeground": "accentColor",
        "valueForeground": "lime"
      }
    },
    "Plugins": {
      "background": "primaryBackground",
      "SearchField": {
        "background": "secondaryBackground"
      },
      "SectionHeader": {
        "foreground": "accentColor",
        "background": "secondaryBackground"
      },
      "Button": {
        "installBackground": "primaryBackground",
        "installBorderColor": "lime",
        "installForeground": "lime",
        "updateBackground": "magenta",
        "updateForeground": "#1a1033"
      }
    },
    "WelcomeScreen": {
      "background": "editorBackground",
      "separatorColor": "separatorColor",
      "SidePanel": {
        "background": "secondaryBackground"
      },
      "Projects": {
        "background": "secondaryBackground",
        "selectionBackground": "selectionBackground",
        "selectionInactiveBackground": "selectionInactive",
        "actions": {
          "background": "secondaryBackground",
          "selectionBackground": "selectionBackground"
        }
      }
    }
  }
}
