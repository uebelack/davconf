# ~/.zshrc — managed by davconf (github.com/uebelack/davconf)
#
# This file lives in git and is shared across machines. Secrets and anything
# machine-specific belong in ~/.zshrc.local, which is sourced near the end and
# is never committed.
#
# Statement order matters: it determines $PATH precedence. Keep it.

# Where this repo is checked out. %x is the file being sourced, so this
# resolves the ~/.zshrc symlink back to the repo wherever davconf lives.
# ($0 does NOT work here: in a startup .zshrc it is the shell, not the file.)
# Needed this early because the prompt config below is sourced before oh-my-zsh.
davconf_dir=${${(%):-%x}:A:h}

export PATH="$HOME/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"

export PATH="$HOME/.rbenv/bin:$PATH"
command -v rbenv >/dev/null && eval "$(rbenv init - zsh)"

# ------------------------------------------------------------------ oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="spaceship"

# The Synthwave '85 prompt. Before oh-my-zsh on purpose: spaceship's sections
# take their defaults the moment the theme loads, and only for settings that
# are not already set.
[[ -f "$davconf_dir/prompt.zsh" ]] && source "$davconf_dir/prompt.zsh"

# Standard plugins live in $ZSH/plugins, custom ones in $ZSH/custom/plugins.
# zsh-autosuggestions and zsh-syntax-highlighting are installed by
# zsh/update.sh; the rest ship with oh-my-zsh.
#
# No nvm plugin: it sources nvm.sh on every start, which costs half a second
# for one directory on $PATH. See the node section below for what replaces it.
plugins=(git rbenv pyenv zsh-syntax-highlighting zsh-autosuggestions docker)

source "$ZSH/oh-my-zsh.sh"

# The rest of the palette: the line you type, the completion menu, ls. After
# oh-my-zsh, because the plugins it loads set these same variables.
[[ -f "$davconf_dir/colors.zsh" ]] && source "$davconf_dir/colors.zsh"

# ----------------------------------------------------------- user configuration
export EDITOR=nvim

# ---------------------------------------------------------------------- node
# Sourcing nvm.sh takes ~500ms of every single shell, and all it does up front
# is put one directory on $PATH. So do that part here — read the default alias
# and resolve it by globbing, no forks, about a millisecond — and leave nvm
# itself for the first command that actually needs it. node, npm and anything
# installed globally are on $PATH immediately, exactly as before.
export NVM_DIR="$HOME/.nvm"

() {
  local aliases=$NVM_DIR/alias target hops=0
  [[ -r $aliases/default ]] || return
  target=$(<$aliases/default)
  # default can point at another alias (lts/*, stable) — follow the chain, but
  # never in circles.
  while [[ -r $aliases/$target ]] && (( hops++ < 5 )); do
    target=$(<$aliases/$target)
  done
  # Numeric glob sort, so v24.9.0 does not outrank v24.14.1 the way it would
  # alphabetically.
  local -a installed=($NVM_DIR/versions/node/v${target#v}*(/Nn))
  (( $#installed )) && path=(${installed[-1]}/bin $path)
}

# nvm itself, on first use. The stub replaces itself with the real thing and
# then re-runs the call that woke it, so `nvm use 20` works from a cold shell.
nvm() {
  unfunction nvm
  local script
  for script in /opt/homebrew/opt/nvm/nvm.sh "$NVM_DIR/nvm.sh"; do
    [[ -s $script ]] && source "$script" && break
  done
  [[ -s /opt/homebrew/opt/nvm/etc/bash_completion.d/nvm ]] &&
    source /opt/homebrew/opt/nvm/etc/bash_completion.d/nvm
  nvm "$@"
}

# -------------------------------------------------------------------- aliases
alias flushdns='sudo killall -HUP mDNSResponder'
alias lg='lazygit'
alias vi='nvim'

# Personal hosts and project shortcuts.
[[ -f "$davconf_dir/zshrc.privat" ]] && source "$davconf_dir/zshrc.privat"

# --------------------------------------------------------------------- prompt
fpath=($fpath "$HOME/.zfunctions")
autoload -U promptinit; promptinit

# ------------------------------------------------------------- build toolchain
export LDFLAGS="-L/opt/homebrew/opt/openssl@3/lib"
export CPPFLAGS="-I/opt/homebrew/opt/openssl@3/include"
export PKG_CONFIG_PATH="/opt/homebrew/opt/openssl@3/lib/pkgconfig"

export ANDROID_SDK_ROOT="$HOME/Library/Android/sdk"
export PATH="$ANDROID_SDK_ROOT/platform-tools:$PATH"

export PATH="$HOME/fvm/default/bin:$PATH"

export PATH="$HOME/.jenv/bin:$PATH"
command -v jenv >/dev/null && eval "$(jenv init -)"

# ---------------------------------------------------------------- completions
[[ -f "$HOME/.dart-cli-completion/zsh-config.zsh" ]] && . "$HOME/.dart-cli-completion/zsh-config.zsh" || true

command -v direnv >/dev/null && eval "$(direnv hook zsh)"

export GPG_TTY=$(tty)

command -v pyenv >/dev/null && eval "$(pyenv init -)"

# LM Studio CLI (lms)
export PATH="$PATH:$HOME/.cache/lm-studio/bin"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# ----------------------------------------------------------- machine-local
# API keys and per-machine overrides. Not in git. See zshrc.local.example.
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# ---------------------------------------------------------------- greeting
# Sourced before the auto-update so the panel reports the state as it was on
# arrival, and the "updating…" notice lands underneath it.
[[ -f "$davconf_dir/greeting.zsh" ]] && source "$davconf_dir/greeting.zsh"

# ------------------------------------------------------------- auto-update
# Refreshes this machine once a day, in the background. Sourced after
# zshrc.local so its DAVCONF_* knobs are already set. See that file to turn
# it off or change the interval.
[[ -f "$davconf_dir/autoupdate.zsh" ]] && source "$davconf_dir/autoupdate.zsh"
unset davconf_dir

# THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"
