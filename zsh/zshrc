# ~/.zshrc — managed by davconf (github.com/uebelack/davconf)
#
# This file lives in git and is shared across machines. Secrets and anything
# machine-specific belong in ~/.zshrc.local, which is sourced near the end and
# is never committed.
#
# Statement order matters: it determines $PATH precedence. Keep it.

export PATH="$HOME/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"

export PATH="$HOME/.rbenv/bin:$PATH"
command -v rbenv >/dev/null && eval "$(rbenv init - zsh)"

# ------------------------------------------------------------------ oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="spaceship"

# Standard plugins live in $ZSH/plugins, custom ones in $ZSH/custom/plugins.
# zsh-autosuggestions and zsh-syntax-highlighting are installed by
# zsh/update.sh; the rest ship with oh-my-zsh.
plugins=(git nvm rbenv pyenv zsh-syntax-highlighting zsh-autosuggestions docker)

source "$ZSH/oh-my-zsh.sh"

# ----------------------------------------------------------- user configuration
export EDITOR=nvim

export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && . "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && . "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

# -------------------------------------------------------------------- aliases
alias flushdns='sudo killall -HUP mDNSResponder'
alias lg='lazygit'

# Personal hosts and project shortcuts. %x is the file being sourced, so this
# resolves the ~/.zshrc symlink back to the repo wherever davconf is cloned.
# ($0 does NOT work here: in a startup .zshrc it is the shell, not the file.)
davconf_dir=${${(%):-%x}:A:h}
[[ -f "$davconf_dir/zshrc.privat" ]] && source "$davconf_dir/zshrc.privat"

# --------------------------------------------------------------------- prompt
fpath=($fpath "$HOME/.zfunctions")
autoload -U promptinit; promptinit

# ------------------------------------------------------------- build toolchain
export LDFLAGS="-L/opt/homebrew/opt/openssl@3/lib"
export CPPFLAGS="-I/opt/homebrew/opt/openssl@3/include"
export PKG_CONFIG_PATH="/opt/homebrew/opt/openssl@3/lib/pkgconfig"

export ANDROID_SDK_ROOT="$HOME/Library/Android/sdk"
export PATH="$ANDROID_SDK_ROOT/platform-tools:$PATH"

export PATH="$HOME/fvm/default/bin:$PATH"

export PATH="$HOME/.jenv/bin:$PATH"
command -v jenv >/dev/null && eval "$(jenv init -)"

# ---------------------------------------------------------------- completions
[[ -f "$HOME/.dart-cli-completion/zsh-config.zsh" ]] && . "$HOME/.dart-cli-completion/zsh-config.zsh" || true

command -v direnv >/dev/null && eval "$(direnv hook zsh)"

export GPG_TTY=$(tty)

command -v pyenv >/dev/null && eval "$(pyenv init -)"

# LM Studio CLI (lms)
export PATH="$PATH:$HOME/.cache/lm-studio/bin"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# pipx
export PATH="$PATH:$HOME/.local/bin"

# ----------------------------------------------------------- machine-local
# API keys and per-machine overrides. Not in git. See zshrc.local.example.
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# ------------------------------------------------------------- auto-update
# Refreshes this machine once a day, in the background. Sourced after
# zshrc.local so its DAVCONF_* knobs are already set. See that file to turn
# it off or change the interval.
[[ -f "$davconf_dir/autoupdate.zsh" ]] && source "$davconf_dir/autoupdate.zsh"
unset davconf_dir

# THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"
