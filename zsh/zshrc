# ~/.zshrc — managed by davconf (github.com/uebelack/davconf)
#
# This file lives in git and is shared across machines. Secrets and anything
# machine-specific belong in ~/.zshrc.local, which is sourced near the end and
# is never committed.
#
# Statement order matters: it determines $PATH precedence. Keep it.

# The zsh/ directory of this repo — the other files sourced below are its
# siblings, so this is the directory rather than the repo root. %x is the file
# being sourced, so it resolves the ~/.zshrc symlink back to the checkout
# wherever davconf lives.
# ($0 does NOT work here: in a startup .zshrc it is the shell, not the file.)
# Needed this early because the prompt config below is sourced before oh-my-zsh.
davconf_dir=${${(%):-%x}:A:h}

# ----------------------------------------------------------------------- term
# zle draws the command line out of the terminfo capabilities for the current
# $TERM. With no entry for it there is nothing to draw with, and the redraw
# degrades into re-emitting what you typed — `ls` comes back as `llss`, and the
# prompt's colours scramble along with it. Readline does the same thing, so bash
# is no better off.
#
# This is a remote-machine problem, and it hits exactly one user per machine.
# ghostty/config enables Ghostty's ssh-terminfo integration, which installs its
# xterm-ghostty entry on the host you ssh into — into *that user's*
# ~/.terminfo, since it has no reason to assume root. `sudo su -` then keeps
# $TERM (su and sudo both pass it through) and changes $HOME, so the terminal
# is still called xterm-ghostty and the file explaining what that means is no
# longer on the search path.
#
# The real fix is a system-wide entry, which the README spells out. This is the
# fallback, because a shell that cannot draw its own input line is too broken to
# leave as a diagnosis: xterm-256color is in ncurses-base on every machine, and
# what it costs against xterm-ghostty is capabilities nothing here uses.
#
# The test is "no entry at all" rather than "missing some capability", and the
# difference matters: `TERM=dumb` legitimately has no cursor-up, and an editor's
# shell-mode that asked for dumb must keep getting dumb. An empty $terminfo is
# the real signal, and reading it costs no fork — the array comes from zsh's own
# module, not from infocmp.
if [[ -n $TERM ]]; then
  zmodload -i zsh/terminfo 2>/dev/null
  if (( ${#terminfo} == 0 )); then
    # Deliberately not a command to copy: the entry cannot be dumped from the
    # account that cannot see it, so the useful instruction depends on where a
    # copy actually exists. That is a paragraph, and it is in the README.
    print -u2 "davconf: no terminfo entry for '$TERM' — using xterm-256color instead."
    print -u2 "         to fix it for every user here, see \"Terminals over ssh\" in the davconf README."
    export TERM=xterm-256color
  fi
fi

export PATH="$HOME/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"

export PATH="$HOME/.rbenv/bin:$PATH"
command -v rbenv >/dev/null && eval "$(rbenv init - zsh)"

# ------------------------------------------------------------------ oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="spaceship"

# The Synthwave '85 prompt. Before oh-my-zsh on purpose: spaceship's sections
# take their defaults the moment the theme loads, and only for settings that
# are not already set.
[[ -f "$davconf_dir/prompt.zsh" ]] && source "$davconf_dir/prompt.zsh"

# Standard plugins live in $ZSH/plugins, custom ones in $ZSH/custom/plugins.
# zsh-autosuggestions and zsh-syntax-highlighting are installed by
# zsh/update.sh; the rest ship with oh-my-zsh.
#
# No nvm plugin: it sources nvm.sh on every start, which costs half a second
# for one directory on $PATH. See the node section below for what replaces it.
plugins=(git rbenv pyenv zsh-syntax-highlighting zsh-autosuggestions docker)

source "$ZSH/oh-my-zsh.sh"

# The rest of the palette: the line you type, the completion menu, ls. After
# oh-my-zsh, because the plugins it loads set these same variables.
[[ -f "$davconf_dir/colors.zsh" ]] && source "$davconf_dir/colors.zsh"

# ----------------------------------------------------------- user configuration
# Neovim is the editor. nvim/ in this repo is a real configuration rather than
# a stock vim with a colorscheme, so there is no reason for git to drop you
# into anything else.
#
# The fallback covers one window: a fresh machine where zsh is already running
# but the package manager has not finished installing neovim. An $EDITOR naming
# a binary that is not there turns `git commit` into an error message instead of
# an editor.
#
# VISUAL as well as EDITOR, because git consults VISUAL first and several other
# tools do too — setting only one leaves which editor you get depending on who
# is asking.
if command -v nvim >/dev/null; then
  export EDITOR=nvim
else
  export EDITOR=vim
fi
export VISUAL=$EDITOR

# ---------------------------------------------------------------------- node
# Sourcing nvm.sh takes ~500ms of every single shell, and all it does up front
# is put one directory on $PATH. So do that part here — read the default alias
# and resolve it by globbing, no forks, about a millisecond — and leave nvm
# itself for the first command that actually needs it. node, npm and anything
# installed globally are on $PATH immediately, exactly as before.
export NVM_DIR="$HOME/.nvm"

() {
  local aliases=$NVM_DIR/alias target hops=0
  [[ -r $aliases/default ]] || return
  target=$(<$aliases/default)
  # default can point at another alias (lts/*, stable) — follow the chain, but
  # never in circles.
  while [[ -r $aliases/$target ]] && (( hops++ < 5 )); do
    target=$(<$aliases/$target)
  done
  # Numeric glob sort, so v24.9.0 does not outrank v24.14.1 the way it would
  # alphabetically.
  local -a installed=($NVM_DIR/versions/node/v${target#v}*(/Nn))
  (( $#installed )) && path=(${installed[-1]}/bin $path)
}

# nvm itself, on first use. The stub replaces itself with the real thing and
# then re-runs the call that woke it, so `nvm use 20` works from a cold shell.
nvm() {
  unfunction nvm
  local script
  for script in /opt/homebrew/opt/nvm/nvm.sh "$NVM_DIR/nvm.sh"; do
    [[ -s $script ]] && source "$script" && break
  done
  [[ -s /opt/homebrew/opt/nvm/etc/bash_completion.d/nvm ]] &&
    source /opt/homebrew/opt/nvm/etc/bash_completion.d/nvm
  nvm "$@"
}

# -------------------------------------------------------------------- aliases
# Same name, same job, two completely different resolvers underneath: macOS
# caches in mDNSResponder, Ubuntu in systemd-resolved. Defined per platform
# rather than left to fail on the one it does not apply to, because the whole
# point of the alias is not having to remember which.
if [[ $OSTYPE == darwin* ]]; then
  alias flushdns='sudo killall -HUP mDNSResponder'
else
  alias flushdns='sudo resolvectl flush-caches'
fi
alias lg='lazygit'
# /usr/bin/vi and /usr/bin/vim are the system's own vim — Apple's on macOS, the
# apt one on Ubuntu — and neither is the editor this repo configures. Both names
# land in Neovim instead, so the reflex gets the config in nvim/ rather than a
# stock vim with none of it. The real one is still reachable as `command vim` if
# anything ever needs it.
#
# Aliases are interactive-shell only, which is why $EDITOR above is set to the
# real binary and not to one of these: a script or a hook that reads $EDITOR
# never sees an alias.
if command -v nvim >/dev/null; then
  alias vi='nvim'
  alias vim='nvim'
else
  alias vi='vim'
fi

# Jump to this repo, wherever it happens to be cloned. :h is the repo root,
# since $davconf_dir is the zsh/ directory inside it. The path is baked in at
# definition time rather than looked up on each call, because $davconf_dir is
# unset at the end of this file — ${(q)…} quotes it so a checkout path with
# spaces still works.
davconf_root=${davconf_dir:h}
alias davconf="cd ${(q)davconf_root}"
unset davconf_root

# Personal hosts and project shortcuts.
[[ -f "$davconf_dir/zshrc.privat" ]] && source "$davconf_dir/zshrc.privat"

# --------------------------------------------------------------------- prompt
fpath=($fpath "$HOME/.zfunctions")
autoload -U promptinit; promptinit

# ------------------------------------------------------------- build toolchain
# Homebrew keeps openssl out of the way of the system one, so anything
# compiling against it — a pyenv Python, a native gem — has to be pointed at
# the keg. Guarded on the directory rather than on the OS: it is also what is
# wrong when a Mac has openssl@3 under a different prefix, and on Ubuntu the
# headers from libssl-dev are in /usr/include where every compiler already
# looks, so there is nothing to set.
if [[ -d /opt/homebrew/opt/openssl@3 ]]; then
  export LDFLAGS="-L/opt/homebrew/opt/openssl@3/lib"
  export CPPFLAGS="-I/opt/homebrew/opt/openssl@3/include"
  export PKG_CONFIG_PATH="/opt/homebrew/opt/openssl@3/lib/pkgconfig"
fi

# The Android SDK and Flutter's version manager, neither of which installs
# through a package manager. macOS-only: the paths are Library ones, and the
# Linux box is headless — there is no emulator to start and no device plugged
# into it.
if [[ $OSTYPE == darwin* ]]; then
  export ANDROID_SDK_ROOT="$HOME/Library/Android/sdk"
  export PATH="$ANDROID_SDK_ROOT/platform-tools:$PATH"

  export PATH="$HOME/fvm/default/bin:$PATH"
fi

export PATH="$HOME/.jenv/bin:$PATH"
command -v jenv >/dev/null && eval "$(jenv init -)"

# ---------------------------------------------------------------- completions
[[ -f "$HOME/.dart-cli-completion/zsh-config.zsh" ]] && . "$HOME/.dart-cli-completion/zsh-config.zsh" || true

command -v direnv >/dev/null && eval "$(direnv hook zsh)"

export GPG_TTY=$(tty)

command -v pyenv >/dev/null && eval "$(pyenv init -)"

# LM Studio CLI (lms)
export PATH="$PATH:$HOME/.cache/lm-studio/bin"

# pnpm. Its global store goes somewhere different on each platform and pnpm
# picks the location itself, so this has to agree with it rather than choose:
# ~/Library/pnpm on macOS, the XDG data directory on Linux.
if [[ $OSTYPE == darwin* ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
else
  export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
fi
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# ----------------------------------------------------------- machine-local
# API keys and per-machine overrides. Not in git. See zshrc.local.example.
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# ---------------------------------------------------------------- greeting
# Sourced before the auto-update so the panel reports the state as it was on
# arrival, and the "updating…" notice lands underneath it.
[[ -f "$davconf_dir/greeting.zsh" ]] && source "$davconf_dir/greeting.zsh"

# ------------------------------------------------------------- auto-update
# Refreshes this machine once a day, in the background. Sourced after
# zshrc.local so its DAVCONF_* knobs are already set. See that file to turn
# it off or change the interval.
[[ -f "$davconf_dir/autoupdate.zsh" ]] && source "$davconf_dir/autoupdate.zsh"
unset davconf_dir

# THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"
