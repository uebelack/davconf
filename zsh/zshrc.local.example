# ~/.zshrc.local — machine-local secrets and overrides. NEVER commit this file.
#
# Copy to ~/.zshrc.local and fill in real values:
#   cp zsh/zshrc.local.example ~/.zshrc.local && chmod 600 ~/.zshrc.local

# source "$HOME/.davconf/zsh/.zshrc.privat"

export OPENAI_API_KEY=
export ANTHROPIC_API_KEY=
export GOOGLE_API_KEY=
export TAVILY_API_KEY=

export LANGSMITH_TRACING=true
export LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
export LANGSMITH_API_KEY=
export LANGSMITH_PROJECT="test"

# --- daily auto-update -------------------------------------------------------
# The first interactive shell of the day refreshes this machine in the
# background. Uncomment to change that.

# DAVCONF_AUTO_UPDATE=0                  # switch it off
# DAVCONF_UPDATE_INTERVAL=86400          # seconds between runs
# DAVCONF_UPDATE_PROFILES="dev cloud"     # override ~/.config/davconf/profiles
# DAVCONF_UPDATE_UPGRADE=0               # install missing, but upgrade nothing

# --- terminal greeting -------------------------------------------------------
# Synthwave sun + weather + machine vitals on every new terminal.

# DAVCONF_GREETING=0                 # no greeting
# DAVCONF_GREETING_ART=0             # vitals only, skip the sun
# DAVCONF_WEATHER_LOCATION=Zurich    # default Basel
