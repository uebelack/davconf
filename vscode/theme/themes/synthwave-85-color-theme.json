  "tokenColors": [
    {
      "name": "Comments — dim enough to skim past",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#495495", "fontStyle": "italic" }
    },
    {
      "name": "Strings — gold, the same as a quoted argument in the shell",
      "scope": ["string", "string.quoted", "punctuation.definition.string", "meta.embedded.assembly"],
      "settings": { "foreground": "#fede5d" }
    },
    {
      "name": "Template and interpolated strings",
      "scope": ["string.template", "punctuation.definition.template-expression", "meta.template.expression"],
      "settings": { "foreground": "#ffb8f3" }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp", "constant.character.escape"],
      "settings": { "foreground": "#ff8b39" }
    },
    {
      "name": "Numbers, booleans, constants",
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other", "support.constant", "variable.other.constant"],
      "settings": { "foreground": "#ff8b39" }
    },
    {
      "name": "Keywords and control flow — magenta, like anything that decides",
      "scope": ["keyword", "keyword.control", "keyword.other", "storage", "storage.type", "storage.modifier", "meta.diff.header"],
      "settings": { "foreground": "#ff7edb" }
    },
    {
      "name": "Operators and punctuation — structure, so coral",
      "scope": ["keyword.operator", "punctuation", "punctuation.separator", "punctuation.terminator", "meta.brace"],
      "settings": { "foreground": "#fe4450" }
    },
    {
      "name": "Functions and methods — cyan, what you call",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function", "meta.require"],
      "settings": { "foreground": "#00f0ff" }
    },
    {
      "name": "Types, classes, interfaces",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.other.inherited-class", "support.class", "support.type", "entity.name.scope-resolution"],
      "settings": { "foreground": "#72f1b8" }
    },
    {
      "name": "Variables and parameters",
      "scope": ["variable", "variable.other.readwrite", "variable.parameter", "meta.definition.variable"],
      "settings": { "foreground": "#d4c8ff" }
    },
    {
      "name": "Object properties",
      "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key"],
      "settings": { "foreground": "#8bfff5" }
    },
    {
      "name": "Language variables — this, self, super",
      "scope": ["variable.language", "variable.language.this"],
      "settings": { "foreground": "#f92aad", "fontStyle": "italic" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#fe4450" }
    },
    {
      "name": "Tag attributes",
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.class", "entity.other.attribute-name.id"],
      "settings": { "foreground": "#fede5d", "fontStyle": "italic" }
    },
    {
      "name": "CSS properties and selectors",
      "scope": ["support.type.property-name.css", "meta.property-name.css"],
      "settings": { "foreground": "#8bfff5" }
    },
    {
      "name": "Decorators and annotations",
      "scope": ["meta.decorator", "punctuation.decorator", "storage.type.annotation", "entity.name.function.decorator"],
      "settings": { "foreground": "#ff8b39", "fontStyle": "italic" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#fe4450", "fontStyle": "bold" }
    },
    {
      "name": "Markdown emphasis",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown strong",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#fede5d", "fontStyle": "bold" }
    },
    {
      "name": "Markdown links and code",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#00f0ff", "fontStyle": "underline" }
    },
    {
      "name": "Markdown inline code and quotes",
      "scope": ["markup.inline.raw", "markup.raw", "markup.quote"],
      "settings": { "foreground": "#72f1b8" }
    },
    {
      "name": "Diff added",
      "scope": ["markup.inserted", "markup.inserted.diff"],
      "settings": { "foreground": "#72f1b8" }
    },
    {
      "name": "Diff removed",
      "scope": ["markup.deleted", "markup.deleted.diff"],
      "settings": { "foreground": "#fe4450" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed", "markup.changed.diff"],
      "settings": { "foreground": "#fede5d" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json", "string.json support.type.property-name"],
      "settings": { "foreground": "#00f0ff" }
    },
    {
      "name": "YAML and TOML keys",
      "scope": ["entity.name.tag.yaml", "support.type.property-name.toml"],
      "settings": { "foreground": "#00f0ff" }
    },
    {
      "name": "Shell built-ins and variables",
      "scope": ["support.function.builtin.shell", "variable.other.normal.shell"],
      "settings": { "foreground": "#00f0ff" }
    },
    {
      "name": "Invalid — the one thing that should stop you",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#fe4450", "fontStyle": "bold underline" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#ff8b39", "fontStyle": "strikethrough" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "parameter": "#d4c8ff",
    "property": "#8bfff5",
    "function": "#00f0ff",
    "method": "#00f0ff",
    "class": "#72f1b8",
    "interface": "#72f1b8",
    "enum": "#72f1b8",
    "enumMember": "#ff8b39",
    "type": "#72f1b8",
    "typeParameter": "#a6ffcb",
    "namespace": "#72f1b8",
    "variable.readonly": "#ff8b39",
    "variable.defaultLibrary": "#f92aad",
    "function.defaultLibrary": "#8bfff5",
    "*.deprecated": { "strikethrough": true }
  }
}
