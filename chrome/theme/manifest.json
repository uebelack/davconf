{
  "manifest_version": 3,
  "name": "Synthwave '85",
  "version": "1.0.0",
  "description": "Outrun / miami-nights Chrome theme — the same palette as the Ghostty config and the terminal greeting in davconf.",
  "theme": {
    "images": {
      "theme_frame": "images/frame.png",
      "theme_toolbar": "images/toolbar.png",
      "theme_ntp_background": "images/ntp.png"
    },
    "colors": {
      "frame": [26, 16, 51],
      "frame_inactive": [22, 14, 43],
      "frame_incognito": [16, 10, 32],
      "frame_incognito_inactive": [13, 8, 26],
      "toolbar": [36, 27, 58],
      "tab_text": [255, 126, 219],
      "tab_background_text": [157, 127, 208],
      "tab_background_text_inactive": [110, 92, 150],
      "bookmark_text": [212, 200, 255],
      "toolbar_button_icon": [0, 240, 255],
      "omnibox_background": [21, 13, 43],
      "omnibox_text": [212, 200, 255],
      "ntp_background": [26, 16, 51],
      "ntp_text": [212, 200, 255],
      "ntp_link": [0, 240, 255],
      "ntp_header": [255, 126, 219],
      "button_background": [36, 27, 58]
    },
    "tints": {
      "buttons": [-1.0, -1.0, -1.0],
      "frame": [-1.0, -1.0, -1.0],
      "background_tab": [-1.0, -1.0, -1.0]
    },
    "properties": {
      "ntp_background_alignment": "bottom",
      "ntp_background_repeat": "no-repeat",
      "ntp_logo_alternate": 1
    }
  }
}
