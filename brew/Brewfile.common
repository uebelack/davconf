# Core — installed on every machine, whatever it is for.
#
# This profile is always applied; the others are opt-in per machine.

# shell and terminal
brew "vim"         # $EDITOR — macOS ships one, but an old build without
                   # +clipboard, so the yank register and the system
                   # clipboard stay separate
brew "gnupg"       # GPG_TTY, signed commits
brew "lazygit"     # the `lg` alias

# Neovim, configured in nvim/ in this repo. $EDITOR stays vim — this is the
# one you open on purpose, not the one git drops you into. ripgrep and fd are
# not optional extras: Telescope shells out to them for live_grep and
# find_files, and silently falls back to something much slower without them.
brew "neovim"
brew "ripgrep"
brew "fd"

# window management — AeroSpace is not in homebrew-core, only in the author's
# own tap. Its config lives in aerospace/aerospace.toml in this repo.
tap "nikitabobko/tap"
cask "aerospace"

# AeroSpace's leader key. Its modifiers are cmd, alt, ctrl and shift and
# nothing else — fn never reaches it — so Karabiner is what turns fn into a
# modifier AeroSpace can bind. On a Swiss German layout that matters: plain alt
# is where [ ] | { } # @ ~ live. See karabiner/ in this repo.
cask "karabiner-elements"

# general tooling
cask "ghostty"
cask "maccy"
cask "fork"
cask "font-fira-code-nerd-font"   # the prompt needs a Nerd Font for its glyphs
