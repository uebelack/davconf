# Core — installed on every machine, whatever it is for.
#
# This profile is always applied; the others are opt-in per machine.

# shell and terminal
brew "vim"         # $EDITOR — macOS ships one, but an old build without
                   # +clipboard, so the yank register and the system
                   # clipboard stay separate
brew "gnupg"       # GPG_TTY, signed commits
brew "lazygit"     # the `lg` alias

# Neovim, configured in nvim/ in this repo, and $EDITOR — zshrc points vi and
# vim at it as well, so there is one editor rather than two. ripgrep and fd are
# not optional extras: Telescope shells out to them for live_grep and
# find_files, and silently falls back to something much slower without them.
brew "neovim"
brew "ripgrep"
brew "fd"

# window management — AeroSpace is not in homebrew-core, only in the author's
# own tap. Its config lives in aerospace/aerospace.toml in this repo.
tap "nikitabobko/tap"
cask "aerospace"

# AeroSpace's leader key. Its modifiers are cmd, alt, ctrl and shift and
# nothing else — fn never reaches it — so Karabiner is what turns fn into a
# modifier AeroSpace can bind. On a Swiss German layout that matters: plain alt
# is where [ ] | { } # @ ~ live. See karabiner/ in this repo.
cask "karabiner-elements"

# general tooling
cask "ghostty"
cask "maccy"
cask "fork"
cask "font-fira-code-nerd-font"   # the prompt needs a Nerd Font for its glyphs

# Docker, without Docker Desktop. The CLI is useless on its own — it needs a
# daemon to talk to — so colima brings up a tiny Lima VM that runs dockerd and
# exposes its socket at ~/.colima/default/docker.sock. Start it once per boot
# with `colima start` (or `brew services start colima` to autostart on login).
#
# docker-compose and docker-buildx are CLI plugins: brew installs them under
# $HOMEBREW_PREFIX/lib/docker/cli-plugins, which the docker CLI does not look
# in by default. One-time, per machine, to make `docker compose` and
# `docker buildx` resolve:
#   mkdir -p ~/.docker/cli-plugins
#   ln -sfn "$(brew --prefix)/opt/docker-compose/bin/docker-compose" ~/.docker/cli-plugins/docker-compose
#   ln -sfn "$(brew --prefix)/opt/docker-buildx/bin/docker-buildx"   ~/.docker/cli-plugins/docker-buildx
brew "docker"
brew "docker-compose"
brew "docker-buildx"
brew "colima"
