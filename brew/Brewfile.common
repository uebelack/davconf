# Core — installed on every machine, whatever it is for.
#
# This profile is always applied; the others are opt-in per machine.

# shell and terminal
brew "neovim"      # $EDITOR
brew "direnv"
brew "gnupg"       # GPG_TTY, signed commits
brew "lazygit"     # the `lg` alias
brew "gh"          # GitHub CLI

# general tooling
brew "docker"      # CLI only; the daemon comes from the docker-desktop cask
brew "ffmpeg"
brew "qrtool"
brew "cdk"         # curses development kit (not the AWS one)

# python — no language profile of its own, these are used everywhere
brew "pyenv"
brew "pyenv-virtualenv"
brew "pipx"
brew "virtualenv"

# cloud CLIs, not tied to any one client
brew "awscli"
cask "gcloud-cli"

cask "ghostty"
cask "iterm2"
cask "raycast"
cask "maccy"
cask "fork"
cask "tableplus"
cask "cursor"
cask "claude-code"
cask "docker-desktop"
cask "font-fira-code-nerd-font"   # the prompt needs a Nerd Font for its glyphs
