# Development toolchains, cloud CLIs and GUI dev tools.
#   brew bundle --file=brew/Brewfile.dev

tap "arthur-ficial/tap", "https://github.com/Arthur-Ficial/homebrew-tap"

# JVM
brew "openjdk@21"
brew "maven"

# Python
brew "pipx"
brew "virtualenv"

# Cloud / infra
brew "awscli"
brew "azure-cli"
brew "cdk"
brew "terraform"

brew "unixodbc"

brew "swiftformat"
brew "vite-plus"
brew "arthur-ficial/tap/apfel"

cask "cursor"
cask "iterm2"
cask "tableplus"
cask "docker-desktop"
cask "gcloud-cli"
cask "temurin@17"
cask "temurin@25"
