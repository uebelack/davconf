# Machines with no install restrictions.
#
# Not just personal apps: work machines are not permitted to install gh,
# docker, Cursor and friends, so anything that cannot go on a restricted
# machine belongs here rather than in common.

# Third-party tap. Homebrew keeps trust in a machine-local ~/.homebrew/trust.json,
# which a Brewfile cannot set, so on a brand-new machine run once:
#   brew trust --tap arthur-ficial/tap
tap "arthur-ficial/tap", "https://github.com/Arthur-Ficial/homebrew-tap", trusted: true

brew "gh"          # GitHub CLI
brew "docker"      # CLI only; the daemon comes from the docker-desktop cask
brew "ffmpeg"
brew "qrtool"
brew "cdk"         # curses development kit (not the AWS one)
cask "raycast"
cask "tableplus"
cask "cursor"
cask "claude-code"
cask "docker-desktop"

# mobile — the Android SDK and fvm install outside Homebrew; zshrc puts
# $ANDROID_SDK_ROOT/platform-tools and ~/fvm/default/bin on $PATH
brew "swiftformat"

# local AI
brew "ollama", restart_service: :changed
brew "openai-whisper"
brew "arthur-ficial/tap/apfel"   # on-device Apple FoundationModels CLI

brew "unixodbc"    # ODBC driver manager, for the SQL Server clients

cask "spotify"
cask "whatsapp"
cask "caffeine"

